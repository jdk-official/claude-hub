#!/usr/bin/env python3
"""claude-hub: pick a recent repo (GitHub + local) and launch claude in it.

Usage: claude-hub [-n COUNT] [--list]
       claude-hub stats                     12-week contribution heatmap
       claude-hub --refresh                 refresh the GitHub cache (run in the background by claude-hub)
       claude-hub --preview PATH SLUG NAME  render the preview pane (called by fzf)

Stdlib only. Needs fzf, git and claude; gh is optional (local repos only without it).
Cache: ~/.cache/claude-hub/repos.json. Config: ~/.config/claude-hub/config (TOML, optional).
"""
import sys

if sys.version_info < (3, 11):
    sys.exit("claude-hub: Python 3.11 or newer is required (found %d.%d)" % sys.version_info[:2])

import fcntl
import glob
import json
import os
import signal
import re
import shlex
import shutil
import subprocess
import tempfile
import textwrap
import time
import tomllib
from concurrent.futures import ThreadPoolExecutor
from datetime import date, datetime, timedelta

HOME = os.path.expanduser("~")
CLONE_ROOT = os.environ.get("CLAUDE_HUB_CLONE_ROOT") or "/mnt/data/github"
CACHE_DIR = os.environ.get("CLAUDE_HUB_CACHE_DIR") or os.path.join(
    os.environ.get("XDG_CACHE_HOME") or os.path.join(HOME, ".cache"), "claude-hub")
CONFIG_PATH = os.environ.get("CLAUDE_HUB_CONFIG") or os.path.join(HOME, ".config", "claude-hub", "config")
STALE_SECS = 24 * 3600
GIT_TIMEOUT = 3
GH_TIMEOUT = 20
PR_TTL = 15 * 60
EXCERPT_LINES = 10
MAX_ROWS = 100
# fzf's <N threshold applies to the preview pane's own width (45% of the terminal), so <45 means a
# terminal narrower than 100 columns: the preview then moves below the list (FR-21/FR-22).
PREVIEW_WINDOW = "right,45%,wrap,<45(down,40%,wrap)"
STATS_DAYS = 400
STATS_TTL = 300
BULK_LINES = 5000   # a single commit above this is a bulk import (vendored code, generated files)
TABS = ("all", "local", "github", "other", "sessions")
TAB_LABEL = {"all": "All", "local": "Local", "github": "GitHub", "other": "Other", "sessions": "Sessions"}
STAT_DAYS = 14  # window for line counts; older commits count toward streaks and sparklines only
IDENTITY_EMAILS = {"jonathan@kyte.me.uk"}
BLOCKS = "▁▂▃▄▅▆▇█"
HEAT = "░▒▓█"

DEFAULT_CONFIG = {
    "owners": ["jdk-official"],
    "scan_roots": [CLONE_ROOT, "/mnt/data/files", "/mnt/data/scratch"],
    "pinned": [],
    "hidden": [],
    "tags": {},
    "count": 10,
    "start_tab": "all",
}

# Never let a repo's own config run code: the scan walks untrusted scratch dirs.
GIT_BASE = ["git", "--no-optional-locks", "-c", "core.fsmonitor=false",
            "-c", "core.hooksPath=/dev/null", "-c", "core.pager=cat"]
NOREPLY_RE = re.compile(r"^(\d+\+)?jdk-official@users\.noreply\.github\.com$", re.I)
CLAUDE_TRAILER_RE = re.compile(r"\bclaude\b|@anthropic\.com", re.I)
CONTROL_RE = re.compile(r"[\x00-\x1f\x7f]")

INSTALL_HINT = {
    "fzf": "sudo pacman -S fzf",
    "git": "sudo pacman -S git",
    "claude": "see https://claude.com/claude-code",
}


# --- small helpers ----------------------------------------------------------

def run(args, cwd=None, timeout=GIT_TIMEOUT):
    """Run a command; return (returncode, stdout, stderr). Never raises."""
    try:
        r = subprocess.run(args, cwd=cwd, capture_output=True, text=True, timeout=timeout)
        return r.returncode, r.stdout.strip(), r.stderr.strip()
    except FileNotFoundError:
        return 127, "", f"{args[0]} not found"
    except (OSError, subprocess.TimeoutExpired):
        return 1, "", "timed out"


def git(args, cwd):
    rc, out, _ = run(GIT_BASE + args, cwd=cwd, timeout=GIT_TIMEOUT)
    return out if rc == 0 else ""


def age(ts, now=None):
    if not ts:
        return "never"
    now = now or time.time()
    d = int((now - ts) // 86400)
    if d < 1:
        return "today"
    if d < 14:
        return f"{d}d ago"
    if d < 90:
        return f"{d // 7}w ago"
    return f"{d // 30}mo ago"


def short_age(secs):
    if secs < 90:
        return "just now"
    if secs < 5400:
        return f"{int(secs // 60)}m ago"
    if secs < 172800:
        return f"{int(secs // 3600)}h ago"
    return f"{int(secs // 86400)}d ago"


# --- P1: tool checks --------------------------------------------------------

def missing_tools(needed):
    return [t for t in needed if shutil.which(t) is None]


def require_tools(needed):
    missing = missing_tools(needed)
    if missing:
        t = missing[0]
        sys.stderr.write(f"claude-hub: {t} not found on PATH. Install: {INSTALL_HINT.get(t, 'install ' + t)}\n")
        sys.exit(127)


# --- P3: config -------------------------------------------------------------

def load_config(path=None):
    """Return (config, warning). A missing file is fine; a bad file falls back to defaults."""
    path = path or CONFIG_PATH
    cfg = {k: (list(v) if isinstance(v, list) else dict(v) if isinstance(v, dict) else v)
           for k, v in DEFAULT_CONFIG.items()}
    try:
        with open(path, "rb") as f:
            data = tomllib.load(f)
    except FileNotFoundError:
        return cfg, None
    except (OSError, tomllib.TOMLDecodeError) as e:
        return cfg, f"config ignored ({e})"
    warn = []
    for key in ("owners", "scan_roots", "pinned", "hidden"):
        if key in data:
            v = data[key]
            if isinstance(v, list) and all(isinstance(x, str) for x in v):
                cfg[key] = [os.path.expanduser(x) for x in v] if key == "scan_roots" else v
            else:
                warn.append(key)
    if "tags" in data:
        v = data["tags"]
        if isinstance(v, dict) and all(isinstance(t, list) for t in v.values()):
            cfg["tags"] = {k: [CONTROL_RE.sub(" ", str(x)).strip() for x in tl if str(x).strip()]
                           for k, tl in v.items()}
        else:
            warn.append("tags")
    if "start_tab" in data:
        v = data["start_tab"]
        if isinstance(v, str) and v.lower() in TABS:
            cfg["start_tab"] = v.lower()
        else:
            warn.append("start_tab")
    if "count" in data:
        v = data["count"]
        if isinstance(v, int) and not isinstance(v, bool) and v > 0:
            cfg["count"] = v
        else:
            warn.append("count")
    return cfg, (f"config: ignored invalid {', '.join(warn)}" if warn else None)


# --- P2: cache --------------------------------------------------------------

def cache_file():
    return os.path.join(CACHE_DIR, "repos.json")


def _valid_date(s):
    try:
        date.fromisoformat(s)
        return True
    except (ValueError, TypeError):
        return False


def sanitize_cache(data):
    """Drop any section whose shape is wrong; a bad cache must never be fatal (FR-4)."""
    clean = {"version": 1}
    gh = data.get("gh")
    if isinstance(gh, dict) and isinstance(gh.get("repos", []), list):
        repos = [r for r in gh.get("repos", []) if isinstance(r, dict)
                 and isinstance(r.get("name"), str) and isinstance(r.get("owner"), str)]
        clean["gh"] = {"fetched_at": gh.get("fetched_at") if isinstance(gh.get("fetched_at"), (int, float)) else 0,
                       "last_attempt": gh.get("last_attempt") if isinstance(gh.get("last_attempt"), (int, float)) else 0,
                       "ok": bool(gh.get("ok")), "error": str(gh.get("error", "")), "repos": repos}
    prs = data.get("prs")
    if isinstance(prs, dict):
        clean["prs"] = {k: v for k, v in prs.items() if isinstance(v, dict)}
    st = data.get("stats")
    if isinstance(st, dict) and isinstance(st.get("days"), dict) and isinstance(st.get("repo_weeks", {}), dict):
        days = {d: v for d, v in st["days"].items()
                if _valid_date(d) and isinstance(v, dict) and isinstance(v.get("c"), int)}
        for v in days.values():
            v.setdefault("ins", 0), v.setdefault("del", 0), v.setdefault("repos", [])
        clean["stats"] = {"computed_at": st.get("computed_at", 0), "days": days,
                          "repo_weeks": {k: v for k, v in st.get("repo_weeks", {}).items() if isinstance(v, dict)},
                          "partial": int(st.get("partial", 0)) if isinstance(st.get("partial", 0), int) else 0}
    return clean


def load_cache():
    """Return the cache dict, or {} if missing, unreadable or corrupt (never fatal)."""
    try:
        with open(cache_file()) as f:
            data = json.load(f)
        if isinstance(data, dict) and data.get("version") == 1:
            return sanitize_cache(data)
    except (OSError, ValueError):
        pass
    return {}


def ensure_cache_dir():
    os.makedirs(CACHE_DIR, mode=0o700, exist_ok=True)
    try:
        if os.stat(CACHE_DIR).st_uid == os.getuid():
            os.chmod(CACHE_DIR, 0o700)
    except OSError:
        pass


def update_cache(fn):
    """Locked read-modify-write: fn(cache) mutates the latest on-disk cache, then it is replaced atomically."""
    tmp = None
    try:
        ensure_cache_dir()
        with open(os.path.join(CACHE_DIR, "cache.lock"), "w") as lf:
            fcntl.flock(lf, fcntl.LOCK_EX)
            cache = load_cache() or {"version": 1}
            fn(cache)
            cache["version"] = 1
            tmp = cache_file() + f".{os.getpid()}.tmp"
            with open(tmp, "w") as f:
                json.dump(cache, f)
            os.replace(tmp, cache_file())
            tmp = None
    except (OSError, TypeError, ValueError):
        pass
    finally:
        if tmp:
            try:
                os.remove(tmp)
            except OSError:
                pass


def save_cache_section(**sections):
    update_cache(lambda c: c.update(sections))


def gh_status_line(cache, gh_present, now=None):
    now = now or time.time()
    gh = cache.get("gh") or {}
    if not gh_present:
        return "GitHub: gh not installed, local only"
    if not gh:
        return "GitHub: loading (local only until the first refresh finishes)"
    ago = short_age(now - gh.get("fetched_at", 0))
    if not gh.get("ok", False):
        if gh.get("repos"):
            return f"GitHub unavailable (cached {ago})"
        return "GitHub unavailable, local only"
    n = len(gh.get("repos", []))
    if now - gh.get("fetched_at", 0) > STALE_SECS:
        return f"GitHub: {n} repos, cache STALE ({ago})"
    return f"GitHub: {n} repos, cached {ago}"


# --- GitHub fetch -----------------------------------------------------------

def fetch_github(owners, prev=None):
    """List repos per owner. A failed owner keeps its previously cached repos (never wiped)."""
    prev = prev or {}
    prev_by_owner = {}
    for r in prev.get("repos", []):
        prev_by_owner.setdefault(r.get("owner"), []).append(r)
    repos, errors, now = [], [], time.time()
    for owner in owners:
        rc, out, err = run(
            ["gh", "repo", "list", owner, "--limit", str(MAX_ROWS), "--json",
             "name,description,pushedAt,visibility,isArchived,pullRequests,issues"], timeout=GH_TIMEOUT)
        got = None
        if rc == 0:
            try:
                got = []
                for r in json.loads(out):
                    r["owner"] = owner
                    # open counts straight from the listing; ordering never depends on what you viewed
                    r["pr_count"] = int((r.pop("pullRequests", None) or {}).get("totalCount", 0))
                    r["issue_count"] = int((r.pop("issues", None) or {}).get("totalCount", 0))
                    got.append(r)
            except (ValueError, TypeError):
                got = None
        if got is None:
            errors.append(err.splitlines()[0] if err else "gh failed")
            repos.extend(prev_by_owner.get(owner, []))
        else:
            repos.extend(got)
    ok = not errors
    return {"fetched_at": now if ok else prev.get("fetched_at", 0), "last_attempt": now,
            "ok": ok, "error": errors[0] if errors else "", "repos": repos}


def refresh_lock():
    return os.path.join(CACHE_DIR, "refresh.lock")


def spawn_refresh():
    """Start a detached `claude-hub --refresh` unless one started in the last minute."""
    try:
        ensure_cache_dir()
        lock = refresh_lock()
        if os.path.exists(lock) and time.time() - os.path.getmtime(lock) < 180:
            return
        open(lock, "w").close()
        subprocess.Popen([sys.executable, os.path.realpath(__file__), "--refresh"],
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
    except OSError:
        pass


def do_refresh(cfg):
    """Refresh GitHub data and statistics. The lock holds this process's pid, and only its owner removes it."""
    me = str(os.getpid())
    owns = False
    try:
        ensure_cache_dir()
        with open(refresh_lock(), "w") as f:
            f.write(me)
        owns = True
    except OSError:
        pass
    try:
        if shutil.which("gh"):
            save_cache_section(gh=fetch_github(cfg["owners"], load_cache().get("gh")))
        refresh_extra(cfg)
    finally:
        try:
            with open(refresh_lock()) as f:
                held_by_us = f.read().strip() == me
            if owns and held_by_us:
                os.remove(refresh_lock())
        except OSError:
            pass


def refresh_extra(cfg):
    """Recompute commit statistics from local clones (no network)."""
    save_cache_section(stats=compute_stats(scan_local(cfg["scan_roots"])))


# --- P4: local scan, merge, de-dup ------------------------------------------

REMOTE_RE = re.compile(
    r"^(?:git@github\.com:|ssh://git@github\.com/|https?://(?:[^@/]+@)?github\.com/)"
    r"([^/]+)/([^/]+?)(?:\.git)?/?$")


def slug_from_remote(url):
    m = REMOTE_RE.match(url or "")
    return f"{m.group(1)}/{m.group(2)}" if m else ""


def inspect_dir(root, path):
    name = os.path.basename(path)
    base = {"name": name, "path": path, "root": root, "is_git": False, "ts": 0,
            "branch": "", "dirty": 0, "ahead": 0, "behind": 0, "has_upstream": False,
            "remote": "", "slug": "", "worktree_of": ""}
    gitpath = os.path.join(path, ".git")
    if os.path.isfile(gitpath):          # a linked worktree: ".git" is a file pointing into the parent repo
        try:
            with open(gitpath) as f:
                target = f.read().strip()
            if target.startswith("gitdir:") and "/.git/worktrees/" in target:
                base["worktree_of"] = os.path.realpath(target[7:].strip().split("/.git/worktrees/")[0])
        except OSError:
            pass
    if os.path.exists(gitpath):
        base["is_git"] = True
        ts = git(["log", "-1", "--format=%ct"], path)
        base["ts"] = int(ts) if ts.isdigit() else 0
        base["branch"] = git(["rev-parse", "--abbrev-ref", "HEAD"], path)
        rc, st, _ = run(GIT_BASE + ["status", "--porcelain"], cwd=path, timeout=GIT_TIMEOUT)
        base["dirty"] = len(st.splitlines()) if rc == 0 else -1  # -1: unknown (timeout or error)
        base["remote"] = git(["remote", "get-url", "origin"], path)
        base["slug"] = slug_from_remote(base["remote"])
        ab = git(["rev-list", "--left-right", "--count", "@{u}...HEAD"], path)
        if ab:
            try:
                behind, ahead = (int(x) for x in ab.split())
                base.update(ahead=ahead, behind=behind, has_upstream=True)
            except ValueError:
                pass
    else:
        try:
            base["ts"] = int(os.path.getmtime(path))
        except OSError:
            pass
    return base


def scan_local(roots):
    dirs = []
    for root in roots:
        try:
            with os.scandir(root) as it:
                for d in sorted(it, key=lambda e: e.name):
                    if d.is_dir() and not d.name.startswith(".") and not CONTROL_RE.search(d.name):
                        dirs.append((root, d.path))
        except OSError:
            continue
    with ThreadPoolExecutor(8) as ex:
        return list(ex.map(lambda rp: inspect_dir(*rp), dirs))


def parse_ts(s):
    try:
        return int(datetime.fromisoformat(s.replace("Z", "+00:00")).timestamp())
    except (ValueError, AttributeError):
        return 0


def origin_label(l):
    """Where a local directory comes from, said plainly: gh:<owner> for a GitHub remote, dir:<root> for a
    scan root that is not the clone root, otherwise local. Never the bare folder name that looked like 'github'."""
    if l.get("slug"):
        return "gh:" + l["slug"].split("/")[0]
    root = os.path.realpath(l["root"].rstrip("/"))
    if root == os.path.realpath(CLONE_ROOT):
        return "local"
    return "dir:" + os.path.basename(root)


def build_entries(local, gh_repos, cfg):
    """Merge local dirs and GitHub repos; de-dup by remote slug; drop hidden/archived."""
    entries, by_slug = [], {}
    for l in sorted(local, key=lambda x: x["ts"], reverse=True):
        # a linked worktree shares its parent's remote but is its own place to work: never de-dup it
        key = l["slug"].lower() if l["slug"] and not l.get("worktree_of") else "path:" + l["path"]
        if key in by_slug:
            continue  # same remote cloned twice: keep the most recently active one
        e = {"name": l["name"], "slug": l["slug"], "path": l["path"], "local": l, "gh": None,
             "ts": l["ts"], "origin": origin_label(l)}
        by_slug[key] = e
        entries.append(e)
    for g in gh_repos:
        slug = f"{g['owner']}/{g['name']}"
        e = by_slug.get(slug.lower())
        if e:
            e["gh"] = g
            e["ts"] = max(e["ts"], parse_ts(g.get("pushedAt")))
        elif not g.get("isArchived"):
            e = {"name": g["name"], "slug": slug, "path": "", "local": None, "gh": g,
                 "ts": parse_ts(g.get("pushedAt")), "origin": "gh:" + g["owner"]}
            by_slug[slug.lower()] = e
            entries.append(e)
    link_worktrees(entries)
    hidden = {h.lower() for h in cfg["hidden"]}
    return [e for e in entries
            if e["name"].lower() not in hidden and e["slug"].lower() not in hidden]


def link_worktrees(entries):
    """Attach each linked worktree to its parent entry (when the parent is listed) and let the parent
    inherit its recency, so work happening in a worktree keeps the project where you expect it."""
    by_real = {os.path.realpath(e["path"]): e for e in entries if e["path"] and not (e["local"] or {}).get("worktree_of")}
    for e in entries:
        parent = by_real.get((e["local"] or {}).get("worktree_of") or "")
        if parent is not None and parent is not e:
            e["parent"] = parent["path"]
            parent.setdefault("worktrees", []).append(e)
            parent["ts"] = max(parent["ts"], e["ts"])


def group_worktrees(entries):
    """Keep the given order, but show each parent's worktrees directly beneath it."""
    children = {}
    for e in entries:
        if e.get("parent"):
            children.setdefault(e["parent"], []).append(e)
    out = []
    for e in entries:
        if e.get("parent"):
            continue
        out.append(e)
        out.extend(sorted(children.get(e["path"], []), key=lambda w: -w["ts"]))
    return out


# --- P5: ordering and markers -----------------------------------------------

def pr_count(e, prs=None):
    """Open PRs as of the last background refresh. `prs` is unused: viewing a repo must not reorder."""
    try:
        return int((e.get("gh") or {}).get("pr_count", 0))
    except (TypeError, ValueError):
        return 0


def needs_attention(e, prs):
    l = e["local"]
    if bool(l and (l["dirty"] > 0 or l["ahead"] > 0)) or pr_count(e, prs) > 0:
        return True
    return any(needs_attention(w, prs) for w in e.get("worktrees", []))


def pinned_index(e, cfg):
    names = {e["name"].lower(), e["slug"].lower()}
    for i, p in enumerate(cfg["pinned"]):
        if p.lower() in names:
            return i
    return None


def order_entries(entries, cfg, prs=None):
    """Pinned (config order), then needs-attention, then most recent activity."""
    def key(e):
        idx = pinned_index(e, cfg)
        if idx is not None:
            return (0, idx, 0)
        return (1, 0 if needs_attention(e, prs) else 1, -e["ts"])
    return sorted(entries, key=key)


def markers(e, cfg, prs=None):
    l, parts = e["local"], []
    if pinned_index(e, cfg) is not None:
        parts.append("★")
    if l and l["dirty"]:
        parts.append(f"●{l['dirty']}")
    if l and l["ahead"]:
        parts.append(f"↑{l['ahead']}")
    if e.get("worktrees"):
        parts.append(f"⎇{len(e['worktrees'])}")
    sess = e.get("sess") or {}
    if sess.get("n"):
        parts.append(f"▶{sess['n']}")
    if sess.get("orphan"):
        parts.append(f"⚠{sess['orphan']}")
    n = pr_count(e, prs)
    if n:
        parts.append(f"PR{n}")
    return " ".join(parts)   # GitHub-only is shown by the leading source glyph, not repeated here


def state_text(e):
    l = e["local"]
    if not l:
        return "not cloned"
    if not l["is_git"]:
        return "folder"
    s = l["branch"] or "?"
    s += " ?" if l["dirty"] < 0 else (f" *{l['dirty']}" if l["dirty"] else " clean")
    if l["behind"]:
        s += f" ↓{l['behind']}"
    if not l["remote"]:
        s += " no-remote"
    return s


SOURCE_GLYPH = {"synced": "◆", "local": "⌂", "github": "◌", "other-owner": "◇", "folder": "▫", "worktree": "↳"}
SOURCE_WORD = {"synced": "local + GitHub", "local": "local only", "github": "GitHub only (not cloned)",
               "other-owner": "someone else's clone", "folder": "plain folder", "worktree": "worktree"}


def source_kind(e, cfg):
    """What this row is: synced, local, github, other-owner, folder or worktree."""
    l, g = e["local"], e["gh"]
    if e.get("parent"):
        return "worktree"
    if l and g:
        return "synced"
    if g and not l:
        return "github"
    if l and not l["is_git"]:
        return "folder"
    owners = {o.lower() for o in cfg["owners"]}
    if l and l["slug"] and l["slug"].split("/")[0].lower() not in owners:
        return "other-owner"
    return "local"


def in_tab(e, cfg, tab):
    """Tab membership. Local and GitHub overlap on purpose (a synced repo is in both)."""
    if tab == "all":
        return True
    kind = source_kind(e, cfg)
    if tab == "local":
        return kind in ("synced", "local", "worktree")
    if tab == "github":
        return kind in ("synced", "github")
    if tab == "other":
        return kind in ("folder", "other-owner")
    return False


def tab_counts(entries, cfg, sessions_n=None):
    c = {tab: sum(1 for e in entries if in_tab(e, cfg, tab)) for tab in TABS if tab != "sessions"}
    c["sessions"] = len(live_sessions()) if sessions_n is None else sessions_n
    return c


def tab_bar(entries, cfg, current, sessions_n=None):
    counts = tab_counts(entries, cfg, sessions_n)
    parts = []
    for tab in TABS:
        text = f"{TAB_LABEL[tab]} {counts[tab]}"
        parts.append(f"[{text}]" if tab == current else text)
    return "◂ " + " · ".join(parts) + " ▸"


STATE_MAX = 26
NAME_MAX = 40


def short(text, n=STATE_MAX):
    return text if len(text) <= n else text[: n - 1] + "…"


def display_name(e):
    """Row label for a project. A worktree directly under its parent repeats the parent's name, so when the name
    is too long the parent prefix is dropped (it is indented beneath it anyway); the rest is capped. The full
    name is always in the preview and is what launches."""
    name = e["name"]
    if len(name) > NAME_MAX and e.get("parent"):
        prefix = os.path.basename(e["parent"].rstrip("/")) + "-"
        if name.startswith(prefix) and len(name) > len(prefix):
            name = name[len(prefix):]
    return short(name, NAME_MAX)


def row_cells(e, cfg, prs=None):
    g = e["gh"] or {}
    # origin comes before state: "where does this live" matters more than the branch text, which is what
    # gets truncated when the list pane is narrow
    return [SOURCE_GLYPH[source_kind(e, cfg)] + " " + display_name(e), markers(e, cfg, prs), age(e["ts"]),
            e["origin"], short(state_text(e)),
            (g.get("visibility") or "").lower(), CONTROL_RE.sub(" ", g.get("description") or "")]


# --- P6/P7: preview ---------------------------------------------------------

def excerpt(path, n=EXCERPT_LINES):
    """First n lines of HANDOVER.md (root, then docs/), else the README. Read live."""
    cands = [os.path.join(path, "HANDOVER.md"), os.path.join(path, "docs", "HANDOVER.md")]
    try:
        cands += sorted(os.path.join(path, f) for f in os.listdir(path)
                        if f.lower().startswith("readme"))
    except OSError:
        return "", []
    for c in cands:
        try:
            with open(c, encoding="utf-8", errors="replace") as f:
                raw = f.read(20000).splitlines()
        except OSError:
            continue
        if raw and raw[0].strip() == "---":  # skip front matter
            closing = [i for i, x in enumerate(raw[1:], 1) if x.strip() == "---"]
            if closing:
                raw = raw[closing[0] + 1:]
        lines = [x.rstrip() for x in raw if x.strip()]
        return os.path.basename(c), lines[:n]
    return "", []


def prs_file():
    return os.path.join(CACHE_DIR, "prs.json")


def load_prs():
    try:
        with open(prs_file()) as f:
            data = json.load(f)
        return {k: v for k, v in data.items() if isinstance(v, dict)} if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def save_pr(slug, entry):
    tmp = None
    try:
        ensure_cache_dir()
        with open(os.path.join(CACHE_DIR, "prs.lock"), "w") as lf:
            fcntl.flock(lf, fcntl.LOCK_EX)
            data = load_prs()
            data[slug] = entry
            tmp = prs_file() + f".{os.getpid()}.tmp"
            with open(tmp, "w") as f:
                json.dump(data, f)
            os.replace(tmp, prs_file())
            tmp = None
    except (OSError, TypeError, ValueError):
        pass
    finally:
        if tmp:
            try:
                os.remove(tmp)
            except OSError:
                pass


def fetch_prs(slug):
    """Open PR and issue counts + top-3 titles via gh; cached for PR_TTL (failures too)."""
    cache = load_cache()
    cur = load_prs().get(slug)
    if cur and time.time() - cur.get("fetched_at", 0) < PR_TTL:
        return cur
    if not shutil.which("gh") or (cache.get("gh") or {}).get("ok") is False:
        return cur
    out = {"fetched_at": time.time()}
    for kind in ("pr", "issue"):
        rc, txt, _ = run(["gh", kind, "list", "-R", slug, "--state", "open", "--limit", "100",
                          "--json", "title"], timeout=8)
        items = None
        if rc == 0:
            try:
                items = json.loads(txt)
            except ValueError:
                items = None
        if not isinstance(items, list):
            out[f"{kind}_error"] = True  # e.g. issues disabled: other kind still counts
            continue
        out[f"{kind}_count"] = len(items)
        out[f"{kind}_titles"] = [str(i.get("title", "")) for i in items[:3] if isinstance(i, dict)]
    save_pr(slug, out)
    return out


def wrap(text, width):
    return textwrap.fill(text, width=max(width, 20), break_long_words=True) if text else ""


def dashboard_text(width=60, today=None):
    """Preview for the home row: the contribution heatmap, streak and a marker legend."""
    cache = load_cache()
    s = cache.get("stats")
    if not s:
        return "~ dashboard\n\nstats: computing (first refresh), see next launch"
    today = today or date.today()
    out = ["~ dashboard", ""]
    out.extend(stats_header(cache, today))
    out.append("")
    out.append("last 12 weeks (local clones, authored commits)")
    out.extend(heatmap(s.get("days", {}), today, color=True))
    out.append("")
    out.append(wrap("Source: ◆ local+GitHub  ⌂ local only  ◌ GitHub only  ◇ someone else's  ▫ folder  ↳ worktree", width))
    out.append(wrap("Markers: ★ pinned  ●N dirty files  ↑N ahead  ⎇N worktrees  ▶N sessions  PRN open PRs", width))
    return "\n".join(out)


def preview_text(path, slug, name, width=60):
    if not (path or slug or name):
        return "nothing selected"
    if slug.startswith("session:"):
        return session_preview(slug, path, width)
    if name == "~":
        return dashboard_text(width)
    out = [name]
    gh = (load_cache().get("gh") or {}).get("repos", [])
    g = next((r for r in gh if slug and f"{r['owner']}/{r['name']}".lower() == slug.lower()), None)
    if g:
        out.append(wrap(f"{slug} · {(g.get('visibility') or '').lower()}", width))
        if g.get("description"):
            out.append(wrap(g["description"], width))
    if path:
        out.append(wrap(path, width))
        l = inspect_dir(os.path.dirname(path), path)
        if l["is_git"]:
            e = {"name": name, "slug": slug, "path": path, "local": l, "gh": g, "ts": l["ts"],
                 "origin": ""}
            out.append(f"{state_text(e)} · {age(l['ts'])}")
            commits = git(["log", "-3", "--format=%h %s (%cr)"], path)
            if commits:
                out.append("")
                out.extend(wrap(c, width) for c in commits.splitlines())
        out.extend(preview_extra(path, name, width))
        out.extend(preview_work_here(path, width))
    else:
        out.append(wrap(f"not cloned: Enter will ask before cloning into {CLONE_ROOT}/{name}", width))
    if slug:
        p = fetch_prs(slug)
        if p:
            out.append("")
            prs_txt = "n/a" if p.get("pr_error") else str(p.get("pr_count", 0))
            iss_txt = "n/a" if p.get("issue_error") else str(p.get("issue_count", 0))
            out.append(f"PRs {prs_txt} · issues {iss_txt}")
            out.extend(wrap("  PR: " + t, width) for t in p.get("pr_titles", []))
            out.extend(wrap("  issue: " + t, width) for t in p.get("issue_titles", []))
    if path:
        fname, lines = excerpt(path)
        if lines:
            out.append("")
            out.append(f"{fname}:")
            out.extend(wrap(x, width) for x in lines)
    return "\n".join(out)


def preview_work_here(path, width):
    """Sessions running in this project and its other worktrees (display only)."""
    out = []
    real = os.path.realpath(path)
    sess = [s for s in live_sessions() if s["cwd"] and under(os.path.realpath(s["cwd"]), real)]
    if sess:
        out += ["", "sessions here:"]
        for s in sess[:6]:
            where = (" " + s["tty"].replace("/dev/", "")) if s["tty"] else ""
            out.append(wrap(f"  {SESSION_GLYPH[s['state']]} {s['state']} · {s['name']}{where}", width))
    wts = git(["worktree", "list", "--porcelain"], path)
    paths = [l[9:] for l in wts.splitlines() if l.startswith("worktree ")]
    others = [w for w in paths if os.path.realpath(w) != real]
    if others:
        out += ["", "worktrees:"]
        out.extend(wrap("  ↳ " + os.path.basename(w), width) for w in others[:6])
    return out


def preview_extra(path, name, width):
    weeks = ((load_cache().get("stats") or {}).get("repo_weeks") or {}).get(path)
    if weeks is None:
        return []
    return ["8 weeks  " + sparkline(weeks, date.today())]


# --- P9-P11: statistics (local git history only, no network) ----------------

def is_bot(name, email):
    return "[bot]" in f"{name} {email}".lower()


def qualifies(name, email, trailers):
    """Authored by the user (email or GitHub noreply), or carrying a Claude co-author trailer."""
    if is_bot(name, email):
        return False
    e = email.lower()
    if e in IDENTITY_EMAILS or NOREPLY_RE.match(e):
        return True
    return bool(CLAUDE_TRAILER_RE.search(trailers))


STAT_RE = re.compile(r"(\d+) insertion|(\d+) deletion")


def parse_log(text):
    """Parse `git log --shortstat` output with our @@ record format into commit dicts."""
    commits, cur = [], None
    for line in text.splitlines():
        if line.startswith("@@"):
            parts = line[2:].split("\x1f")
            if len(parts) >= 4:  # run() strips output, which eats a trailing empty trailers field
                cur = {"hash": parts[0], "email": parts[1], "name": parts[2], "date": parts[3],
                       "trailers": parts[4] if len(parts) > 4 else "", "ins": 0, "del": 0}
                commits.append(cur)
        elif cur is not None and "changed" in line:
            for m in STAT_RE.finditer(line):
                if m.group(1):
                    cur["ins"] += int(m.group(1))
                if m.group(2):
                    cur["del"] += int(m.group(2))
    return commits


LOG_FORMAT = "@@%H%x1f%ae%x1f%an%x1f%ad%x1f%(trailers:key=Co-authored-by,valueonly,separator=%x2c)"


def _log(path, days, shortstat, timeout):
    args = GIT_BASE + ["log", "--all", "--no-merges", f"--since={days}.days.ago",
                       "--date=format-local:%Y-%m-%d", "--format=" + LOG_FORMAT]
    if shortstat:
        args.insert(len(GIT_BASE) + 1, "--shortstat")
    rc, out, _ = run(args, cwd=path, timeout=timeout)
    return parse_log(out) if rc == 0 else None


def repo_commits(path, days=STATS_DAYS):
    """Qualifying commits for the window. Dates come from a cheap log over the whole window; line
    counts (--shortstat is slow on big histories) only for the recent STAT_DAYS used by today/week."""
    base = _log(path, days, False, 30)
    if base is None:
        return None  # unknown: timed out or failed; caller flags the stats as partial
    recent = _log(path, STAT_DAYS, True, 30)
    stats = {c["hash"]: (c["ins"], c["del"]) for c in (recent or [])}
    seen, res = set(), []
    for c in base:
        if c["hash"] in seen or not qualifies(c["name"], c["email"], c["trailers"]):
            continue
        seen.add(c["hash"])
        c["ins"], c["del"] = stats.get(c["hash"], (0, 0))
        res.append(c)
    return res


def monday(d):
    return d - timedelta(days=d.weekday())


def aggregate(per_repo):
    """per_repo: {path: (name, commits)} -> cached stats structure."""
    days, repo_weeks = {}, {}
    for path, (name, commits) in per_repo.items():
        rw = {}
        for c in commits:
            try:
                d = date.fromisoformat(c["date"])
            except ValueError:
                continue
            e = days.setdefault(c["date"], {"c": 0, "ins": 0, "del": 0, "bulk_ins": 0, "bulk_del": 0, "repos": []})
            e["c"] += 1
            if c["ins"] + c["del"] > BULK_LINES:     # vendored or generated imports would drown real work
                e["bulk_ins"] += c["ins"]
                e["bulk_del"] += c["del"]
            else:
                e["ins"] += c["ins"]
                e["del"] += c["del"]
            if name not in e["repos"]:
                e["repos"].append(name)
            wk = monday(d).isoformat()
            rw[wk] = rw.get(wk, 0) + 1
        repo_weeks[path] = rw
    return {"computed_at": time.time(), "days": days, "repo_weeks": repo_weeks, "partial": 0}


def compute_stats(local):
    """Group clones by remote; the picker's choice (most recent clone) names the repo, and commits
    from all clones of one remote are unioned by hash so unpushed work in any clone counts."""
    groups = {}
    for l in local:
        if l["is_git"]:
            key = l["slug"].lower() if l["slug"] else "path:" + l["path"]
            groups.setdefault(key, []).append(l)
    paths = [l["path"] for g in groups.values() for l in g]
    with ThreadPoolExecutor(8) as ex:
        results = dict(zip(paths, ex.map(repo_commits, paths)))
    per_repo, partial = {}, 0
    for g in groups.values():
        chosen = max(g, key=lambda l: l["ts"])
        merged, seen = [], set()
        for l in g:
            commits = results.get(l["path"])
            if commits is None:
                partial += 1
                continue
            for c in commits:
                if c["hash"] not in seen:
                    seen.add(c["hash"])
                    merged.append(c)
        per_repo[chosen["path"]] = (chosen["name"], merged)
    st = aggregate(per_repo)
    st["partial"] = partial
    return st


def active_dates(days):
    return {date.fromisoformat(d) for d, v in days.items() if v.get("c", 0) > 0}


def streaks(active, today):
    """(current, best). The current streak stays alive until a full day passes with no commit."""
    day = today if today in active else today - timedelta(days=1)
    cur = 0
    while day in active:
        cur += 1
        day -= timedelta(days=1)
    best = run_len = 0
    prev = None
    for d in sorted(active):
        run_len = run_len + 1 if prev and (d - prev).days == 1 else 1
        best = max(best, run_len)
        prev = d
    return cur, best


def period_totals(days, start, end):
    """(commits, distinct repos, insertions, deletions) for start..end inclusive."""
    c = ins = dele = 0
    repos = set()
    d = start
    while d <= end:
        v = days.get(d.isoformat())
        if v:
            c += v["c"]
            ins += v["ins"]
            dele += v["del"]
            repos.update(v.get("repos", []))
        d += timedelta(days=1)
    return c, len(repos), ins, dele


def period_bulk(days, start, end):
    """(insertions, deletions) that came from bulk commits in start..end inclusive."""
    ins = dele = 0
    d = start
    while d <= end:
        v = days.get(d.isoformat())
        if v:
            ins += v.get("bulk_ins", 0)
            dele += v.get("bulk_del", 0)
        d += timedelta(days=1)
    return ins, dele


def avg_weekly_commits(days, today):
    """Mean commits per week over the 4 complete weeks before the current one."""
    this_mon = monday(today)
    total = sum(period_totals(days, this_mon - timedelta(weeks=i),
                              this_mon - timedelta(weeks=i) + timedelta(days=6))[0]
                for i in range(1, 5))
    return total / 4


def kfmt(n):
    return f"{n / 1000:.1f}k" if n >= 1000 else str(n)


def spark_chars(values):
    mx = max(values) if values else 0
    out = ""
    for v in values:
        if v <= 0 or mx <= 0:
            out += BLOCKS[0]
        else:
            out += BLOCKS[min(7, max(1, -(-v * 7 // mx)))]
    return out


def sparkline(weeks, today, n=8):
    """Commits per Monday-based week for the last n weeks (oldest first)."""
    this_mon = monday(today)
    return spark_chars([weeks.get((this_mon - timedelta(weeks=i)).isoformat(), 0)
                        for i in range(n - 1, -1, -1)])


SHADES = (238, 22, 28, 34, 40)  # 256-colour: none, then four greens like GitHub's graph


def heatmap(days, today, weeks=12, color=False):
    """Rows Mon..Sun, columns oldest week first; at most 80 columns wide. color=True uses coloured
    squares (for the picker preview); otherwise plain glyphs that survive pipes and logs."""
    start = monday(today) - timedelta(weeks=weeks - 1)
    counts = [days.get((start + timedelta(days=i)).isoformat(), {}).get("c", 0)
              for i in range(weeks * 7)]
    mx = max(counts)

    def level(c):  # 0 = none, 1..4 = low..high, relative to the busiest day
        if c <= 0 or mx <= 0:
            return 0
        return min(4, -(-c * 4 // mx))

    def cell(idx):
        if color:
            return f"\x1b[38;5;{SHADES[idx]}m■\x1b[0m"
        return "·" if idx == 0 else HEAT[idx - 1]
    names = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]
    lines = []
    for r in range(7):
        cells = []
        for w in range(weeks):
            d = start + timedelta(days=w * 7 + r)
            cells.append(" " if d > today else cell(level(counts[w * 7 + r])))
        lines.append(f"{names[r]}  " + " ".join(cells))
    scale = " ".join(cell(i) for i in range(5))
    lines.append(f"      less {scale} more   weeks start {start.isoformat()}")
    return lines


# --- Sessions: open, background, orphaned and past Claude Code sessions ------

SESSION_GLYPH = {"working": "▶", "attached": "◉", "detached": "○", "terminal": "▣", "headless": "⚙",
                 "orphan": "⚠", "stale": "✗", "past": "·"}
SESSION_RANK = {"working": 0, "attached": 1, "detached": 2, "terminal": 3, "headless": 4, "orphan": 5,
                "stale": 6, "past": 7}
SESSION_EXPLAIN = {
    "working": "background session, working; nobody is viewing it",
    "attached": "background session, open in a terminal",
    "detached": "background session, idle or done; nobody is viewing it",
    "terminal": "interactive session running in a terminal",
    "headless": "non-interactive session (claude -p / SDK): no terminal by design, not orphaned",
    "orphan": "interactive session still running but its terminal is gone",
    "stale": "registry entry whose process has exited",
    "past": "finished session; resumable from its transcript",
}
PAST_LIMIT = 40


def claude_dir():
    return os.environ.get("CLAUDE_HUB_CLAUDE_DIR") or os.path.join(HOME, ".claude")


def proc_start(pid):
    """Process start time in clock ticks (field 22 of /proc/PID/stat), or None if it is not running."""
    try:
        with open(f"/proc/{pid}/stat") as f:
            return f.read().rsplit(")", 1)[1].split()[19]
    except (OSError, IndexError):
        return None


def proc_tty(pid):
    try:
        return os.readlink(f"/proc/{pid}/fd/0")
    except OSError:
        return ""


def proc_cmdline(pid):
    try:
        with open(f"/proc/{pid}/cmdline") as f:
            return f.read().replace("\0", " ")
    except OSError:
        return ""


def is_headless(entry):
    """Print-mode / SDK sessions have no terminal by design; they are not abandoned."""
    ep = entry.get("entrypoint") or ""
    if ep and ep != "cli":
        return True
    cmd = " " + proc_cmdline(entry["pid"]) + " "
    return " -p " in cmd or " --print " in cmd


def tty_alive(tty):
    return tty.startswith("/dev/pts/") and os.path.exists(tty)


def read_registry():
    out = []
    for fn in glob.glob(os.path.join(claude_dir(), "sessions", "*.json")):
        try:
            with open(fn) as f:
                d = json.load(f)
        except (OSError, ValueError):
            continue
        if isinstance(d, dict) and isinstance(d.get("pid"), int) and d.get("sessionId"):
            d["_file"] = fn
            out.append(d)
    return out


def transcript_head(path):
    """(title, cwd, has_user_message) from the first lines of a transcript; cheap on huge files."""
    title = cwd = ""
    has_user = False
    try:
        with open(path, errors="replace") as f:
            for i, line in enumerate(f):
                if i > 120 or (title and cwd and has_user):
                    break
                try:
                    d = json.loads(line)
                except ValueError:
                    continue
                if not isinstance(d, dict):
                    continue
                if d.get("type") == "user":
                    has_user = True
                if not title and d.get("type") == "ai-title":
                    title = str(d.get("aiTitle") or "")
                if not cwd and isinstance(d.get("cwd"), str):
                    cwd = d["cwd"]
    except OSError:
        pass
    return title, cwd, has_user


def find_transcripts():
    """{sessionId: (path, mtime)} across every project directory."""
    found = {}
    for path in glob.glob(os.path.join(claude_dir(), "projects", "*", "*.jsonl")):
        try:
            found[os.path.basename(path)[:-6]] = (path, os.path.getmtime(path))
        except OSError:
            continue
    return found


def classify_live(entries, now=None):
    """Turn registry entries into session dicts with a state; spare (pre-warmed) entries are hidden."""
    now = now or time.time()
    live = [e for e in entries if not e.get("spare")]
    parked = {}
    for e in live:
        if e.get("kind") == "interactive" and e.get("parkedJobId") and proc_start(e["pid"]) is not None:
            parked[e["parkedJobId"]] = proc_tty(e["pid"])
    out = []
    for e in live:
        started = proc_start(e["pid"])
        running = started is not None and (not e.get("procStart") or str(e["procStart"]) == started)
        tty = proc_tty(e["pid"]) if running else ""
        job = e.get("jobId") or ""
        if not running:
            state = "stale"
        elif e.get("kind") == "interactive":
            state = "terminal" if tty_alive(tty) else ("headless" if is_headless(e) else "orphan")
        elif job in parked:
            state = "attached"
        elif e.get("status") == "busy":
            state = "working"
        else:
            state = "detached"
        where = parked.get(job, "") if state == "attached" else tty
        if not where.startswith("/dev/pts/"):  # pipes, sockets and /dev/null are not a terminal
            where = ""
        out.append({"sid": e["sessionId"], "job": job, "name": str(e.get("name") or e["sessionId"][:8]),
                    "cwd": e.get("cwd") or "", "kind": e.get("kind") or "", "state": state,
                    "status": e.get("status") or "", "pid": e["pid"], "tty": where,
                    "updated": (e.get("updatedAt") or e.get("startedAt") or 0) / 1000,
                    "file": e.get("_file", "")})
    return out


def load_sessions(limit_past=PAST_LIMIT, now=None):
    """All sessions worth showing: live ones first (by state), then the most recent past sessions."""
    entries = read_registry()
    live = classify_live(entries, now)
    live_ids = {s["sid"] for s in live} | {e["sessionId"] for e in entries}   # includes hidden spares
    transcripts = find_transcripts()
    past = []
    recent = sorted((kv for kv in transcripts.items() if kv[0] not in live_ids),
                    key=lambda kv: kv[1][1], reverse=True)[:limit_past]
    for sid, (path, mtime) in recent:
        title, cwd, has_user = transcript_head(path)
        if not has_user:      # blank pre-warmed stubs and aborted starts: nothing to resume
            continue
        past.append({"sid": sid, "job": "", "name": title or sid[:8], "cwd": cwd, "kind": "past",
                     "state": "past", "status": "", "pid": 0, "tty": "", "updated": mtime, "file": path})
    live.sort(key=lambda s: (SESSION_RANK[s["state"]], -s["updated"]))
    return live + past


def session_counts():
    """Cheap summary for the header: live states from the registry plus the number of past transcripts."""
    c = {}
    live = classify_live(read_registry())
    for s in live:
        c[s["state"]] = c.get(s["state"], 0) + 1
    ids = {s["sid"] for s in live}
    ids |= {e["sessionId"] for e in read_registry()}
    c["past"] = sum(1 for sid in find_transcripts() if sid not in ids)
    return c


def sessions_summary(counts=None):
    c = counts if counts is not None else session_counts()
    parts = []
    for key, label in (("working", "working"), ("attached", "attached"), ("detached", "detached"),
                       ("terminal", "in terminals"), ("headless", "headless"), ("orphan", "ORPHANED"),
                       ("stale", "stale")):
        if c.get(key):
            parts.append(f"{c[key]} {label}")
    parts.append(f"{c.get('past', 0)} resumable")
    return "sessions: " + " · ".join(parts)


def session_slug(s):
    return f"session:{s['state']}:{s['job']}:{s['pid']}:{s['sid']}"


def session_lines(sessions):
    """Same 7-field layout as project rows so the picker bindings stay identical."""
    rows = []
    for s in sessions:
        loc = s["tty"].replace("/dev/", "") if s["tty"] else ""
        tag = "#bg" if s["kind"] in ("bg", "background") else ("#past" if s["state"] == "past" else "#terminal")
        rows.append((s, CONTROL_RE.sub(" ", s["name"]), tag, loc))
    nw = max([len(r[1]) for r in rows] or [0])
    tw = max([len(r[2]) for r in rows] or [0])
    lines = []
    for s, name, tag, loc in rows:
        cols = (f"{SESSION_GLYPH[s['state']]} {s['state']:<8}  {age(s['updated']):<9}  {loc:<8}  {s['cwd']}").rstrip()
        lines.append("\t".join([s["sid"], name.ljust(nw), tag.ljust(tw), cols, s["cwd"], session_slug(s), name]))
    return lines


def transcript_tail(path, max_bytes=200_000):
    """Last user prompt and last assistant text from the end of a transcript (best effort)."""
    try:
        size = os.path.getsize(path)
        with open(path, "rb") as f:
            f.seek(max(0, size - max_bytes))
            data = f.read().decode("utf-8", "replace")
    except OSError:
        return "", ""
    user = assistant = ""
    for line in data.splitlines()[1:]:
        try:
            d = json.loads(line)
        except ValueError:
            continue
        msg = d.get("message") if isinstance(d, dict) else None
        if not isinstance(msg, dict):
            continue
        content = msg.get("content")
        text = ""
        if isinstance(content, str):
            text = content
        elif isinstance(content, list):
            text = " ".join(c.get("text", "") for c in content if isinstance(c, dict) and c.get("type") == "text")
        text = " ".join(text.split())
        if not text or text.startswith("<"):
            continue
        if d.get("type") == "user":
            user = text
        elif d.get("type") == "assistant":
            assistant = text
    return user, assistant


def session_preview(slug, cwd, width=60):
    parts = (slug.split(":") + [""] * 5)[:5]
    state, job, pid, sid = parts[1], parts[2], parts[3], parts[4]
    info = next((s for s in load_sessions() if s["sid"] == sid), None)
    out = [info["name"] if info else sid[:8], f"{SESSION_GLYPH.get(state, '?')} {state}: {SESSION_EXPLAIN.get(state, '')}"]
    out.append(wrap(f"id {sid}", width))
    if cwd:
        out.append(wrap(cwd, width))
    if info:
        out.append(f"last activity {age(info['updated'])}" + (f" · pid {info['pid']}" if info["pid"] else "")
                   + (f" · {info['tty'].replace('/dev/', '')}" if info["tty"] else ""))
        user, assistant = transcript_tail(info["file"]) if info["file"].endswith(".jsonl") else ("", "")
        if not info["file"].endswith(".jsonl"):
            tr = find_transcripts().get(sid)
            if tr:
                user, assistant = transcript_tail(tr[0])
        if user:
            out += ["", "last prompt:", wrap(user[:400], width)]
        if assistant:
            out += ["", "last reply:", wrap(assistant[:600], width)]
    hint = {"working": "enter: attach (claude attach)   ctrl-x: stop",
            "attached": "enter: attach (claude attach)   ctrl-x: stop",
            "detached": "enter: attach (claude attach)   ctrl-x: stop",
            "terminal": "open in another terminal: switch to it (it cannot be attached)",
            "headless": "running without a terminal (claude -p / SDK); leave it alone",
            "orphan": "ctrl-x: stop the leftover process",
            "stale": "ctrl-x: remove the stale registry entry",
            "past": "enter: resume (claude --resume) in its directory"}.get(state, "")
    if hint:
        out += ["", hint]
    return "\n".join(out)


def session_stop(slug):
    """Confirmed, minimal clean-up for one session. Never touches anything but the named session."""
    if not slug.startswith("session:"):
        return 0
    parts = (slug.split(":") + [""] * 5)[:5]
    state, job, pid, sid = parts[1], parts[2], int(parts[3] or 0), parts[4]
    entry = next((s for s in classify_live(read_registry()) if s["sid"] == sid), None)
    if state in ("working", "attached", "detached") and job:
        what = f"stop background session {job}"
        action = lambda: subprocess.run(["claude", "stop", job]).returncode == 0
    elif state == "orphan" and entry and entry["pid"] == pid:
        what = f"send SIGTERM to leftover claude process {pid}"
        action = lambda: (os.kill(pid, signal.SIGTERM), True)[1]
    elif state == "stale" and entry and entry["file"]:
        what = f"remove stale registry entry {os.path.basename(entry['file'])}"
        action = lambda: (os.remove(entry["file"]), True)[1]
    else:
        print("nothing to stop for this row (past sessions keep their transcript; terminal sessions are live).")
        input("press enter ")
        return 0
    try:
        ans = input(f"{what}? [y/N] ").strip().lower()
    except (EOFError, KeyboardInterrupt):
        ans = ""
    if ans != "y":
        return 0
    try:
        ok = action()
    except OSError as e:
        print(f"failed: {e}")
        ok = False
    print("done" if ok else "failed")
    time.sleep(0.6)
    return 0 if ok else 1


def mode_state_file():
    return os.environ.get("CLAUDE_HUB_MODE_STATE") or os.path.join(CACHE_DIR, "mode.state")


def current_tab(default="all"):
    try:
        with open(mode_state_file()) as f:
            v = f.read().strip()
    except OSError:
        return default
    if v == "projects":          # value written by the pre-tabs version
        return "all"
    return v if v in TABS else default


def set_tab(tab):
    try:
        os.makedirs(os.path.dirname(mode_state_file()), exist_ok=True)
        with open(mode_state_file(), "w") as f:
            f.write(tab if tab in TABS else "all")
    except OSError:
        pass


def step_tab(how):
    """how: 'next', 'prev', or a 1-based number. Returns the new tab (wraps around)."""
    cur = TABS.index(current_tab())
    if how == "next":
        new = (cur + 1) % len(TABS)
    elif how == "prev":
        new = (cur - 1) % len(TABS)
    else:
        try:
            new = min(max(int(how), 1), len(TABS)) - 1
        except ValueError:
            new = cur
    set_tab(TABS[new])
    return TABS[new]


def current_mode():
    return "sessions" if current_tab() == "sessions" else "projects"


def set_mode(mode):
    set_tab("sessions" if mode == "sessions" else "all")


def toggle_mode():
    new = "all" if current_tab() == "sessions" else "sessions"
    set_tab(new)
    return "sessions" if new == "sessions" else "projects"


# --- P8: launch -------------------------------------------------------------

def claude_argv(resume=False, home=None):
    """Same flags the user's `claude` shell function adds: the project-dashboard mod, if installed."""
    mod = os.path.join(home or HOME, ".claude", "mods", "project-dashboard")
    argv = ["claude"]
    if os.path.isdir(mod):
        argv += ["--plugin-dir", mod]
    if resume:
        argv.append("--continue")
    return argv


def launch(target, resume=False):
    os.chdir(target)
    argv = claude_argv(resume)
    os.execvp("claude", argv)


def github_reachable():
    rc, _, _ = run(["gh", "api", "rate_limit", "--silent"], timeout=6)
    return rc == 0


def open_session(slug, cwd):
    """Enter on a session row: attach a background session, resume a past one, or explain."""
    parts = (slug.split(":") + [""] * 5)[:5]
    state, job, sid = parts[1], parts[2], parts[4]
    if state in ("working", "attached", "detached") and job:
        os.execvp("claude", ["claude", "attach", job])
        return
    if state == "past":
        target = cwd if cwd and os.path.isdir(cwd) else HOME
        if target != cwd:
            sys.stderr.write(f"claude-hub: {cwd or 'its directory'} no longer exists; resuming from {HOME}\n")
        os.chdir(target)
        os.execvp("claude", claude_argv(False) + ["--resume", sid])
        return
    if state == "headless":
        sys.exit("claude-hub: that is a non-interactive (claude -p / SDK) session; it has no terminal to attach")
    if state == "terminal":
        sys.exit("claude-hub: that session is running in another terminal; switch to that window "
                 "(a live terminal session cannot be attached from here)")
    sys.exit("claude-hub: that session is not running; press ctrl-x on it to clean it up")


def clone_repo(slug, name):
    """Ask, then clone into CLONE_ROOT/<name>. Return the path, or exit leaving nothing behind."""
    if not name or "/" in name or name in (".", "..") or CONTROL_RE.search(name):
        sys.exit(f"claude-hub: refusing to clone into an unsafe name: {name!r}")
    target = os.path.join(CLONE_ROOT, name)
    if os.path.exists(target):
        return target
    if not shutil.which("gh"):
        sys.exit("claude-hub: gh is not installed, cannot clone " + slug)
    if (load_cache().get("gh") or {}).get("ok") is False and not github_reachable():
        sys.exit(f"claude-hub: GitHub is unreachable, cannot clone {slug} now. Nothing was changed.")
    try:
        ans = input(f"Clone {slug} to {target}? [y/N] ").strip().lower()
    except (EOFError, KeyboardInterrupt):
        ans = ""
    if ans != "y":
        sys.exit("claude-hub: not cloned")
    if os.path.exists(target):  # appeared while the prompt was open (another session): never touch it
        return target
    rc = subprocess.run(["gh", "repo", "clone", slug, target]).returncode
    if rc != 0:
        # target was verified absent immediately before the clone, so anything there is a partial of ours
        if os.path.isdir(target):
            shutil.rmtree(target, ignore_errors=True)
        sys.exit(f"claude-hub: clone of {slug} failed (GitHub unreachable or no access); nothing was left on disk")
    return target


# --- main -------------------------------------------------------------------

def stats_header(cache, today=None):
    s = cache.get("stats")
    if not s:
        return ["stats: computing (first refresh), see next launch"]
    today = today or date.today()
    days = s.get("days", {})
    cur, best = streaks(active_dates(days), today)
    t = period_totals(days, today, today)
    w = period_totals(days, monday(today), today)
    avg = avg_weekly_commits(days, today)
    note = f" · stats partial ({s['partial']} repos timed out)" if s.get("partial") else ""
    tb, wb = period_bulk(days, today, today), period_bulk(days, monday(today), today)
    tbulk = f" (+{kfmt(sum(tb))} bulk)" if sum(tb) else ""
    wbulk = f" (+{kfmt(sum(wb))} bulk)" if sum(wb) else ""
    return [f"streak {cur}d (best {best}d) · today {t[0]}c {t[1]}r +{kfmt(t[2])}/-{kfmt(t[3])}{tbulk}",
            f"week {w[0]}c {w[1]}r +{kfmt(w[2])}/-{kfmt(w[3])}{wbulk} (avg {avg:.0f}c/wk){note}"]


def tag_state_file():
    return os.environ.get("CLAUDE_HUB_TAG_STATE") or os.path.join(CACHE_DIR, "tag.state")


def all_tags(cfg):
    return sorted({tag for tags in cfg["tags"].values() for tag in tags})


def current_tag():
    try:
        with open(tag_state_file()) as f:
            return f.read().strip()
    except OSError:
        return ""


def cycle_tag(cfg):
    """none -> first tag -> ... -> last tag -> none. State lives in a per-session file."""
    tags = all_tags(cfg)
    cur = current_tag()
    order = [""] + tags
    nxt = order[(order.index(cur) + 1) % len(order)] if cur in order else ""
    try:
        os.makedirs(os.path.dirname(tag_state_file()), exist_ok=True)
        with open(tag_state_file(), "w") as f:
            f.write(nxt)
    except OSError:
        pass
    return nxt


def repo_tags(e, cfg):
    for key in (e["slug"], e["name"]):
        for k, v in cfg["tags"].items():
            if key and k.lower() == key.lower():
                return v
    return []


def header_lines(cache, cfg, warn, gh_present, entries=None):
    if entries is None:
        entries = gather(cfg)[1]
    lines = list(stats_header(cache))
    lines.append(gh_status_line(cache, gh_present))
    lines.append(sessions_summary())
    tag = current_tag()
    if tag:
        lines.append(f"tag filter: #{tag}  (ctrl-t cycles tags)")
    if warn:
        lines.append(warn)
    lines.append(tab_bar(entries, cfg, current_tab()))
    return lines


FOOTER = "enter open · ctrl-l resume · ctrl-r refresh · ctrl-t tags\nctrl-s/alt-s next/prev tab · alt-1..5 jump · ctrl-x stop · esc quit"


def under(path, base):
    base = base.rstrip("/")
    return path == base or path.startswith(base + "/")


def live_sessions():
    return [s for s in classify_live(read_registry()) if s["state"] != "stale"]


def attach_session_badges(entries, sessions=None):
    """Count live sessions per project (longest matching directory wins). Returns the home-row counts.
    Badges are display only: they never influence ordering, so nothing moves because a session started."""
    sessions = live_sessions() if sessions is None else sessions
    paths = sorted({os.path.realpath(e["path"]): e for e in entries if e["path"]}.items(),
                   key=lambda kv: len(kv[0]), reverse=True)
    home = {"n": 0, "orphan": 0}
    for s in sessions:
        cwd = os.path.realpath(s["cwd"]) if s["cwd"] else ""
        target = next((e for p, e in paths if cwd and under(cwd, p)), None)
        bucket = target.setdefault("sess", {"n": 0, "orphan": 0}) if target is not None else (
            home if cwd == os.path.realpath(HOME) else None)
        if bucket is None:
            continue
        bucket["n"] += 1
        if s["state"] == "orphan":
            bucket["orphan"] += 1
    return home


def gather(cfg):
    cache = load_cache()
    local = scan_local(cfg["scan_roots"])
    gh_repos = (cache.get("gh") or {}).get("repos", [])
    entries = group_worktrees(order_entries(build_entries(local, gh_repos, cfg), cfg, cache.get("prs")))
    entries = entries[:MAX_ROWS]
    cache["_home_sessions"] = attach_session_badges(entries)     # in-memory only, never saved
    return cache, entries


def fzf_lines(entries, cfg, cache, tag="", tab="all"):
    """Tab fields: 1 id (identity across reloads), 2 name, 3 tags, 4 columns, 5 path, 6 slug, 7 name.
    fzf displays fields 2-4 and searches fields 2-3 only (name and tags), so a query never matches
    the age, branch or marker text."""
    if tab != "all":
        entries = [e for e in entries if in_tab(e, cfg, tab)]
    if tag:
        entries = [e for e in entries if tag in repo_tags(e, cfg)]
    rows = [row_cells(e, cfg, cache.get("prs")) for e in entries]
    if tab != "all" and len(rows) > 1 and len({r[3] for r in rows}) == 1:
        for r in rows:
            r[3] = ""          # every row here comes from the same place; the preview still names it
    w = [max([len(r[i]) for r in rows] or [0]) for i in range(6)]
    tagtxt = [" ".join("#" + x for x in repo_tags(e, cfg)) for e in entries]
    tw = max([len(x) for x in tagtxt] or [0])
    lines = []
    if not tag and tab in ("all", "local"):
        hs = cache.get("_home_sessions") or {}
        badge = ("  ▶%d" % hs["n"] if hs.get("n") else "") + ("  ⚠%d" % hs["orphan"] if hs.get("orphan") else "")
        lines.append("\t".join(["~", "~", " " * tw, "(home: dashboard, system and account work)" + badge,
                               HOME, "", "~"]))
    for e, r, tg in zip(entries, rows, tagtxt):
        cols = "  ".join(r[i].ljust(w[i]) for i in range(1, 6)) + "  " + r[6]
        ident = e["slug"] or e["path"] or e["name"]
        lines.append("\t".join([ident, r[0].ljust(w[0]), tg.ljust(tw), cols.rstrip(),
                               e["path"], e["slug"], e["name"]]))
    return lines


EMPTY_ID = "~empty"


def ensure_rows(lines, tab="all"):
    """fzf must never be handed an empty list: under --track an empty reload leaves the previous tab's rows on
    screen (or blocks input). An empty tab gets one inert placeholder row that Enter and ctrl-x ignore."""
    if lines:
        return lines
    text = "(no sessions)" if tab == "sessions" else f"(nothing in the {TAB_LABEL.get(tab, tab)} tab)"
    return ["\t".join([EMPTY_ID, text, "", "", "", "", ""])]


def me_cmd():
    return f"{shlex.quote(sys.executable)} {shlex.quote(os.path.realpath(__file__))}"


class UnixHTTP:
    """Minimal HTTP client for fzf's --listen unix socket."""

    def __init__(self, path):
        self.path = path

    def request(self, method, body=b"", timeout=3):
        import socket
        s = socket.socket(socket.AF_UNIX)
        s.settimeout(timeout)
        s.connect(self.path)
        head = f"{method} / HTTP/1.0\r\nHost: localhost\r\nContent-Length: {len(body)}\r\n\r\n"
        s.sendall(head.encode() + body)
        data = b""
        while True:
            chunk = s.recv(65536)
            if not chunk:
                break
            data += chunk
        s.close()
        return data


def cache_mtime():
    try:
        return os.path.getmtime(cache_file())
    except OSError:
        return 0


def watch_refresh(sock, proc, seen):
    """For the life of fzf: whenever a background refresh finishes (lock gone, cache changed), rebuild the
    list and header inside the running fzf. Never blocks input; failures are retried on the next change."""
    http = UnixHTTP(sock)
    me = me_cmd()
    ready = False
    while proc.poll() is None:
        try:
            if not ready:
                http.request("GET")
                ready = True
            if not os.path.exists(refresh_lock()):
                m = cache_mtime()
                if m != seen:
                    # the prompt depends on the current mode (projects or sessions)
                    reply = http.request("POST", (f"transform-prompt({me} --prompt)+transform-header({me} --header)"
                                                  f"+reload({me} --lines)").encode())
                    if b" 200 " in reply.split(b"\r\n", 1)[0] or not reply:
                        seen = m
        except OSError:
            pass
        time.sleep(0.25)


def make_session_dir():
    """Private (0700) per-session directory for the fzf socket and tag state; short path, never stale."""
    for base in (os.environ.get("XDG_RUNTIME_DIR"), tempfile.gettempdir()):
        if base and os.path.isdir(base):
            try:
                d = tempfile.mkdtemp(prefix="claude-hub-", dir=base)
                if len(os.path.join(d, "fzf.sock").encode()) < 100:
                    return d
                shutil.rmtree(d, ignore_errors=True)
            except OSError:
                continue
    return None


def fzf_missing_features():
    rc, out, err = run(["fzf", "--help"], timeout=5)
    text = out + err
    if rc != 0 or not text:
        return []
    return [f for f in ("--listen", "--footer", "--id-nth", "--header-first", "--track") if f not in text]


def main(argv):
    args = argv[1:]
    if args[:1] == ["--preview"] and len(args) >= 4:
        print(preview_text(args[1], args[2], args[3], int(os.environ.get("FZF_PREVIEW_COLUMNS") or 60)))
        return 0
    cfg, warn = load_config()
    if args[:1] == ["stats"]:
        return run_stats(args[1:], cfg)
    if "--session-stop" in args:   # ctrl-x (run with the terminal, so it can ask for confirmation)
        return session_stop(args[args.index("--session-stop") + 1])
    if "--tab" in args:           # ctrl-s / alt-s / alt-1..5
        step_tab(args[args.index("--tab") + 1])
        return 0
    if "--toggle-mode" in args:
        toggle_mode()
        return 0
    if "--prompt" in args:
        print("session> " if current_mode() == "sessions" else "repo> ", end="")
        return 0
    if args[:1] == ["sessions"]:     # plain text list, handy over ssh / remote control
        for s in load_sessions():
            print(f"{SESSION_GLYPH[s['state']]} {s['state']:<8} {age(s['updated']):<9} {s['name'][:38]:<38} {s['cwd']}")
        print(sessions_summary())
        return 0
    if "--kick-refresh" in args:   # ctrl-r: start a detached refresh and return immediately
        spawn_refresh()
        return 0
    if "--refresh" in args:
        do_refresh(cfg)
        if "--lines" not in args:
            return 0
    if "--cycle-tag" in args:
        cycle_tag(cfg)
        if "--lines" not in args:
            return 0
    if "--header" in args:   # the tab bar counts rows, so this does one local scan
        print("\n".join(header_lines(load_cache(), cfg, warn, shutil.which("gh") is not None)))
        return 0
    if "--lines" in args:
        tab = current_tab()
        if tab == "sessions":
            print("\n".join(ensure_rows(session_lines(load_sessions()), tab)))
            return 0
        cache, entries = gather(cfg)
        print("\n".join(ensure_rows(fzf_lines(entries, cfg, cache, current_tag(), tab), tab)))
        return 0
    n = cfg["count"]
    if "-n" in args:
        try:
            n = int(args[args.index("-n") + 1])
            if n < 1:
                raise ValueError
        except (ValueError, IndexError):
            sys.exit("claude-hub: -n needs a positive number")
    list_only = "--list" in args
    require_tools(["git"] if list_only else ["git", "fzf", "claude"])
    cache, entries = gather(cfg)
    gh_present = shutil.which("gh") is not None
    lines = fzf_lines(entries, cfg, cache)
    if list_only:
        for ln in lines[: n + 1]:
            f = ln.split("\t")
            print(f[1] + "  " + f[3])
        return 0
    missing = fzf_missing_features()
    if missing:
        sys.exit(f"claude-hub: this fzf is too old (missing {', '.join(missing)}). Upgrade: sudo pacman -S fzf")
    seen = cache_mtime()
    spawn_refresh()
    start_tab = cfg["start_tab"]
    if "--sessions" in args:
        start_tab = "sessions"
    if "--tab-name" in args:
        v = args[args.index("--tab-name") + 1]
        start_tab = v if v in TABS else start_tab
    sess = make_session_dir()
    env = dict(os.environ)
    me = me_cmd()
    live = sess is not None
    if live:
        env["CLAUDE_HUB_MODE_STATE"] = os.path.join(sess, "mode.state")
        os.environ["CLAUDE_HUB_MODE_STATE"] = env["CLAUDE_HUB_MODE_STATE"]
    set_tab(start_tab)
    if start_tab == "sessions":
        lines = ensure_rows(session_lines(load_sessions()), start_tab)
    else:
        lines = ensure_rows(fzf_lines(entries, cfg, cache, "", start_tab), start_tab)
    argv_fzf = ["fzf", "--delimiter", "\t", "--tabstop", "1", "--with-nth", "2,3,4", "--nth", "1,2",
                "--height", "100%", "--layout", "reverse", "--header-first",
                "--prompt", "session> " if start_tab == "sessions" else "repo> ",
                "--expect", "ctrl-l", "--preview", f"{me} --preview {{5}} {{6}} {{7}}",
                "--preview-window", PREVIEW_WINDOW]
    if live:
        sock = os.path.join(sess, "fzf.sock")
        env["CLAUDE_HUB_TAG_STATE"] = os.path.join(sess, "tag.state")
        os.environ["CLAUDE_HUB_TAG_STATE"] = env["CLAUDE_HUB_TAG_STATE"]   # so header_lines sees the same state
        argv_fzf += [
            "--footer", FOOTER, "--listen", sock, "--track", "--id-nth", "1",
            # Enter on the placeholder row of an empty tab does nothing (it would otherwise close the picker)
            "--bind", f"enter:transform:[ {{1}} = {shlex.quote(EMPTY_ID)} ] && echo ignore || echo accept",
            # ctrl-r returns at once (the refresh runs detached and the watcher reloads when it finishes).
            # Header updates go BEFORE reload: under --track fzf drops actions queued after a reload.
            "--bind", f"ctrl-r:change-prompt(refreshing> )+execute-silent({me} --kick-refresh)",
            "--bind", f"ctrl-t:execute-silent({me} --cycle-tag)+transform-header({me} --header)+reload({me} --lines)",
            # tabs: every tab switch updates state first, then prompt, header (before reload) and list
            *[x for key, how in (("ctrl-s", "next"), ("alt-s", "prev"), ("alt-1", "1"), ("alt-2", "2"),
                                 ("alt-3", "3"), ("alt-4", "4"), ("alt-5", "5"))
              for x in ("--bind", (f"{key}:execute-silent({me} --tab {how})+transform-prompt({me} --prompt)"
                                   f"+transform-header({me} --header)+reload({me} --lines)"))],
            "--bind", f"ctrl-x:execute({me} --session-stop {{6}})+transform-header({me} --header)+reload({me} --lines)"]
    else:
        warn = (warn + " · " if warn else "") + "live refresh unavailable (no private runtime dir)"
    header = "\n".join(header_lines(cache, cfg, warn, gh_present, entries))
    argv_fzf += ["--header", header]
    proc = subprocess.Popen(argv_fzf, stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True, env=env)
    if live:
        import threading
        threading.Thread(target=watch_refresh, args=(sock, proc, seen), daemon=True).start()
    try:
        out_text, _ = proc.communicate("\n".join(lines))
    finally:
        if sess:
            shutil.rmtree(sess, ignore_errors=True)
    rc = proc.returncode
    if rc not in (0, 1, 130):
        sys.stderr.write(f"claude-hub: fzf failed (exit {rc})\n")
        return rc
    if rc != 0:
        return 0
    out = out_text.split("\n")
    key, pick = out[0], (out[1] if len(out) > 1 else "")
    if not pick:
        return 0
    f = (pick.split("\t") + [""] * 7)[:7]
    if f[0] == EMPTY_ID:          # the placeholder row of an empty tab
        return 0
    name, path, slug = f[1].strip(), f[4], f[5]
    if slug.startswith("session:"):
        open_session(slug, path)
        return 0
    resume = key == "ctrl-l"
    if name == "~":
        launch(HOME, resume)
    if not path:
        path = clone_repo(slug, f[6])
    launch(path, resume)
    return 0


def run_stats(args, cfg):
    require_tools(["git"])
    cache = load_cache()
    s = cache.get("stats")
    if not s or time.time() - s.get("computed_at", 0) > STATS_TTL:
        s = compute_stats(scan_local(cfg["scan_roots"]))
        save_cache_section(stats=s)
    days = s.get("days", {})
    if "--days" in args:
        for d in sorted(days):
            print(f"{d} {days[d]['c']}")
        return 0
    print("\n".join(stats_header({"stats": s})))
    print()
    print("\n".join(heatmap(days, date.today(), color=sys.stdout.isatty())))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
